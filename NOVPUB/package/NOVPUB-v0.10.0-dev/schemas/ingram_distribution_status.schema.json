{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ingram Distribution Status",
  "type": "object",
  "properties": {
    "edition_id": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "markets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "enabled_at": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "NOT_ENABLED",
        "ACTIVE",
        "PARTIAL",
        "SUSPENDED",
        "WITHDRAWN"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true,
  "required": [
    "edition_id",
    "enabled",
    "markets",
    "status"
  ]
}
