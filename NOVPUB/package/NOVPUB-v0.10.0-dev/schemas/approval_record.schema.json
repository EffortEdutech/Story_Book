{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approval Record",
  "type": "object",
  "required": [
    "approval_id",
    "subject",
    "decision",
    "approved_by",
    "approved_at"
  ],
  "properties": {
    "approval_id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "decision": {
      "enum": [
        "approved",
        "rejected",
        "conditional"
      ]
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "approved_at": {
      "type": "string"
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
