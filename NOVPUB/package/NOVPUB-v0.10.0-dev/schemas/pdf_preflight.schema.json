{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PDF Preflight",
  "type": "object",
  "properties": {
    "profile": {
      "type": "string"
    },
    "file_hash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "page_count": {
      "type": "integer",
      "minimum": 1
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "passed": {
      "type": "boolean"
    }
  },
  "additionalProperties": true,
  "required": [
    "profile",
    "file_hash",
    "page_count",
    "errors",
    "warnings",
    "passed"
  ]
}
