{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KDP Rule Snapshot",
  "type": "object",
  "properties": {
    "snapshot_id": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "rules": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "refresh_before_live_use": {
      "type": "boolean"
    }
  },
  "additionalProperties": true,
  "required": [
    "snapshot_id",
    "verified_at",
    "rules"
  ]
}
