{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Financial Reconciliation",
  "type": "object",
  "properties": {
    "reconciliation_id": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3
    },
    "expected": {
      "type": "number"
    },
    "reported": {
      "type": "number"
    },
    "paid": {
      "type": "number"
    },
    "variance_expected_reported": {
      "type": "number"
    },
    "variance_reported_paid": {
      "type": "number"
    },
    "threshold_absolute": {
      "type": "number",
      "minimum": 0
    },
    "threshold_percentage": {
      "type": "number",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "MATCHED",
        "MINOR_VARIANCE",
        "INVESTIGATION_REQUIRED",
        "UNRECONCILED"
      ]
    }
  },
  "additionalProperties": true,
  "required": [
    "reconciliation_id",
    "currency",
    "expected",
    "reported",
    "paid",
    "status"
  ]
}
