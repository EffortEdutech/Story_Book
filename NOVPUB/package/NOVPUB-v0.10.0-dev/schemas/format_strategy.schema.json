{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Format Strategy",
  "type": "object",
  "properties": {
    "strategy_id": {
      "type": "string"
    },
    "editions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "edition_id",
          "format",
          "production_required"
        ],
        "properties": {
          "edition_id": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "production_required": {
            "type": "boolean"
          },
          "channels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "approved": {
      "type": "boolean"
    }
  },
  "additionalProperties": true,
  "required": [
    "strategy_id",
    "editions",
    "approved"
  ]
}
