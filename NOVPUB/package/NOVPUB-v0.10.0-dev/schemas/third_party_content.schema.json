{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "content_id",
    "content_type",
    "status"
  ],
  "properties": {
    "content_id": {
      "type": "string"
    },
    "content_type": {
      "type": "string"
    },
    "location": {
      "type": [
        "string",
        "null"
      ]
    },
    "rights_holder": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "original_author_content",
        "permission_not_required_verified",
        "public_domain_verified",
        "licensed",
        "permission_obtained",
        "replace",
        "remove",
        "unresolved"
      ]
    },
    "basis": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
