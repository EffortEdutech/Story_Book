{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trim Profile",
  "type": "object",
  "properties": {
    "edition_id": {
      "type": "string"
    },
    "width_in": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "height_in": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "estimated_pages": {
      "type": "integer",
      "minimum": 1
    },
    "bleed": {
      "type": "boolean"
    },
    "channels_supported": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approved": {
      "type": "boolean"
    }
  },
  "additionalProperties": true,
  "required": [
    "edition_id",
    "width_in",
    "height_in",
    "estimated_pages",
    "bleed",
    "channels_supported",
    "approved"
  ]
}
