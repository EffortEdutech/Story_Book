{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rule Freshness Result",
  "type": "object",
  "properties": {
    "rule_id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "authoritative": {
      "type": "boolean"
    },
    "verified_at": {
      "type": "string"
    },
    "ttl_days": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "CURRENT",
        "STALE",
        "UNKNOWN"
      ]
    }
  },
  "required": [
    "rule_id",
    "source",
    "authoritative",
    "verified_at",
    "status"
  ],
  "additionalProperties": true
}
