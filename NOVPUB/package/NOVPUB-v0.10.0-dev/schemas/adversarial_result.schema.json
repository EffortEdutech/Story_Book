{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adversarial Result",
  "type": "object",
  "properties": {
    "attack_id": {
      "type": "string"
    },
    "expected": {
      "type": "string"
    },
    "actual": {
      "type": "string"
    },
    "passed": {
      "type": "boolean"
    },
    "severity": {
      "type": "string",
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "attack_id",
    "passed",
    "severity"
  ],
  "additionalProperties": true
}
