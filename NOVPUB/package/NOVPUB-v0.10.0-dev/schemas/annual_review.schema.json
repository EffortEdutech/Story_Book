{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Annual Publication Review",
  "type": "object",
  "properties": {
    "review_id": {
      "type": "string"
    },
    "review_date": {
      "type": "string"
    },
    "areas": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "open_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "ACTION_REQUIRED",
        "OVERDUE"
      ]
    },
    "approved_by": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "review_id",
    "review_date",
    "areas",
    "status"
  ]
}
