{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "title": "NOVPUB Pilot Evidence Matrix",
  "properties": {
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "skill_id",
          "pilot_status"
        ],
        "properties": {
          "skill_id": {
            "type": "string",
            "pattern": "^NPUB-[0-9]{2}$"
          },
          "pilot_status": {
            "enum": [
              "REAL_EXECUTED",
              "NOT_APPLICABLE_WITH_JUSTIFICATION"
            ]
          }
        }
      }
    }
  },
  "required": [
    "skills"
  ]
}
