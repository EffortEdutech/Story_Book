{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Book Model",
  "type": "object",
  "properties": {
    "book_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "section_id",
          "kind",
          "sequence"
        ],
        "properties": {
          "section_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "source_reference": {
            "type": "string"
          }
        }
      }
    },
    "source_hash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    }
  },
  "additionalProperties": true,
  "required": [
    "book_id",
    "title",
    "language",
    "sections",
    "source_hash"
  ]
}
