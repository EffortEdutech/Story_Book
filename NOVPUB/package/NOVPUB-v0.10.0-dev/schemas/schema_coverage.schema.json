{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Schema Coverage",
  "type": "object",
  "properties": {
    "artefacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "coverage_percent": {
      "type": "number"
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ]
    }
  },
  "required": [
    "artefacts",
    "status"
  ],
  "additionalProperties": true
}
