{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOVPUB Release Candidate",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "requirements": {
      "type": "object",
      "additionalProperties": true
    },
    "professional_review_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "COMPLETE"
      ]
    },
    "human_release_approval": {
      "type": "boolean"
    },
    "approved_by": {
      "type": "string"
    },
    "gate_result": {
      "type": "string",
      "enum": [
        "PENDING",
        "PASS",
        "FAIL",
        "CONDITIONAL"
      ]
    }
  },
  "required": [
    "version",
    "requirements",
    "professional_review_status",
    "human_release_approval",
    "gate_result"
  ],
  "additionalProperties": true
}
