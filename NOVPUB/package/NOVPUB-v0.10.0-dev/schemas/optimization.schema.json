      "type": "string"
    },
    "observation": {
      "type": "string"
    },
    "hypothesis": {
      "type": "string"
    },
    "change_proposed": {
      "type": "string"
    },
    "affected_phase": {
      "type": "string"
    },
    "risk": {
      "type": "string"
    },
    "approved": {
      "type": "boolean"
    },
    "approved_by": {
      "type": "string"
    },
    "start_date": {
      "type": "string"
    },
    "measurement_window": {
      "type": "string"
