{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ingram Title Metadata",
  "type": "object",
  "properties": {
    "edition_id": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "enum": [
        "paperback",
        "hardcover",
        "ebook"
      ]
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "series": {
      "type": "string"
    },
    "edition": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "contributors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "publisher": {
      "type": "string"
    },
    "imprint": {
      "type": "string"
    },
    "isbn": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "subjects": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "audience": {
      "type": "string"
    },
    "publication_date": {
      "type": "string"
    },
    "on_sale_date": {
      "type": "string"
    },
    "markets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approved": {
      "type": "boolean"
    }
  },
  "additionalProperties": true,
  "required": [
    "edition_id",
    "format",
    "title",
    "author",
    "imprint",
    "isbn",
    "language",
    "description",
    "subjects",
    "markets",
    "approved"
  ]
}
