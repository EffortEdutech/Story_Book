{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Royalty Scenarios",
  "type": "object",
  "properties": {
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scenario_id": {
            "type": "string"
          },
          "edition_id": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "list_price": {
            "type": "number",
            "minimum": 0
          },
          "calculated_compensation": {
            "type": "number"
          }
        },
        "required": [
          "scenario_id",
          "edition_id",
          "channel",
          "currency",
          "list_price",
          "calculated_compensation"
        ],
        "additionalProperties": true
      },
      "minItems": 1
    }
  },
  "additionalProperties": true,
  "required": [
    "scenarios"
  ]
}
