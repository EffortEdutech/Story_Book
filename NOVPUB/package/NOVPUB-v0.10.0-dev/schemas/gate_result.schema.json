{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gate Result",
  "type": "object",
  "required": [
    "gate_id",
    "status",
    "evidence"
  ],
  "properties": {
    "gate_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PENDING",
        "PASS",
        "FAIL",
        "CONDITIONAL",
        "NOT_APPLICABLE"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
