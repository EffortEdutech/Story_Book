{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metadata Manifest",
  "type": "object",
  "properties": {
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "value": {},
          "source": {
            "type": "string"
          },
          "authority": {
            "type": "string"
          },
          "mutable": {
            "type": "boolean"
          },
          "approved": {
            "type": "boolean"
          }
        },
        "required": [
          "field",
          "source",
          "authority",
          "mutable",
          "approved"
        ],
        "additionalProperties": true
      },
      "minItems": 1
    }
  },
  "additionalProperties": true,
  "required": [
    "fields"
  ]
}
