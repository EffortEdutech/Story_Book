{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact Manifest",
  "type": "object",
  "required": [
    "artifacts"
  ],
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "path",
          "status"
        ],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "ACTIVE",
              "SUPERSEDED",
              "HISTORICAL",
              "PENDING"
            ]
          },
          "derived_from": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "supersedes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
