{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Amazon Format Linkage",
  "type": "object",
  "properties": {
    "work_id": {
      "type": "string"
    },
    "formats": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "status": {
      "type": "string",
      "enum": [
        "linked",
        "partially_linked",
        "unlinked",
        "investigation_required"
      ]
    },
    "checked_at": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "work_id",
    "formats",
    "status"
  ]
}
