{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provenance Graph",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "hash": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "type"
        ],
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "relation": {
            "type": "string",
            "enum": [
              "DERIVED_FROM",
              "SUPERSEDES",
              "APPROVED_BY",
              "SUBMITTED_AS",
              "LIVE_AS"
            ]
          }
        },
        "required": [
          "from",
          "to",
          "relation"
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "required": [
    "nodes",
    "edges"
  ]
}
