{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KDP Proof Record",
  "type": "object",
  "properties": {
    "proof_id": {
      "type": "string"
    },
    "edition_id": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "enum": [
        "paperback",
        "hardcover"
      ]
    },
    "requested": {
      "type": "boolean"
    },
    "quantity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "received": {
      "type": "boolean"
    },
    "inspected": {
      "type": "boolean"
    },
    "blocking_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval": {
      "type": "string",
      "enum": [
        "PENDING",
        "PASS",
        "FAIL"
      ]
    },
    "approved_by": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "proof_id",
    "edition_id",
    "format",
    "requested",
    "received",
    "inspected",
    "approval"
  ]
}
