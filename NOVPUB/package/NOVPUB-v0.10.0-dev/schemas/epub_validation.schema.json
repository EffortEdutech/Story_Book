{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EPUB Validation",
  "type": "object",
  "properties": {
    "file_hash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "validator": {
      "type": "string"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reading_qa": {
      "enum": [
        "PENDING",
        "PASS",
        "FAIL"
      ]
    },
    "passed": {
      "type": "boolean"
    }
  },
  "additionalProperties": true,
  "required": [
    "file_hash",
    "validator",
    "errors",
    "warnings",
    "reading_qa",
    "passed"
  ]
}
