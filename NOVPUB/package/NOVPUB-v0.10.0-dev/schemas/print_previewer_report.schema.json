{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KDP Print Previewer Report",
  "type": "object",
  "properties": {
    "edition_id": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "enum": [
        "paperback",
        "hardcover"
      ]
    },
    "previewed": {
      "type": "boolean"
    },
    "blocking_errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manual_qa": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approved": {
      "type": "boolean"
    },
    "approved_by": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "edition_id",
    "format",
    "previewed",
    "blocking_errors",
    "approved"
  ]
}
