{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Issue Register",
  "type": "object",
  "required": [
    "issues"
  ],
  "properties": {
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "issue_id",
          "severity",
          "status",
          "description"
        ],
        "properties": {
          "issue_id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "CRITICAL",
              "MAJOR",
              "MODERATE",
              "MINOR",
              "INFO"
            ]
          },
          "status": {
            "enum": [
              "OPEN",
              "IN_REVIEW",
              "RESOLVED",
              "ACCEPTED_RISK",
              "SUPERSEDED"
            ]
          },
          "description": {
            "type": "string"
          },
          "source_skill": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
