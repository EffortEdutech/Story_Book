{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KDP Account Readiness",
  "type": "object",
  "properties": {
    "account": {
      "type": "object",
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "accessible": {
          "type": "boolean"
        }
      },
      "required": [
        "exists",
        "accessible"
      ],
      "additionalProperties": true
    },
    "identity": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": true
    },
    "tax": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": true
    },
    "payments": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": true
    },
    "restrictions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ready_for_submission": {
      "type": "boolean"
    }
  },
  "additionalProperties": true,
  "required": [
    "account",
    "identity",
    "tax",
    "payments",
    "ready_for_submission"
  ]
}
