{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Launch Calendar",
  "type": "object",
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "planned_date": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requires_live_listing": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "event_id",
          "event",
          "planned_date",
          "dependencies",
          "status"
        ],
        "additionalProperties": true
      },
      "minItems": 1
    },
    "dependencies_resolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approved": {
      "type": "boolean"
    },
    "approved_by": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "events",
    "dependencies_resolved",
    "approved"
  ]
}
