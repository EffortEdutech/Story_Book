{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ingram Physical Proof",
  "type": "object",
  "properties": {
    "proof_id": {
      "type": "string"
    },
    "edition_id": {
      "type": "string"
    },
    "ordered": {
      "type": "boolean"
    },
    "received": {
      "type": "boolean"
    },
    "inspected": {
      "type": "boolean"
    },
    "blocking_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": true
      }
    },
    "approval": {
      "type": "string",
      "enum": [
        "PENDING",
        "PASS",
        "FAIL"
      ]
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "proof_id",
    "edition_id",
    "ordered",
    "received",
    "inspected",
    "blocking_findings",
    "approval"
  ]
}
